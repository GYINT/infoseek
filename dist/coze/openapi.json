{
  "openapi": "3.0.1",
  "info": {
    "title": "Infoseek Research API",
    "description": "端到端内容智能采集与调研：16 个规范工具（11 async + research_v3 + research_stream + manage_keys + key_usage + qcm_query 跨 skill 协同）。经 REST 桥 POST /tools/<name>（Bearer 鉴权）。",
    "version": "1.0.1"
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8765"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/tools/research_v3": {
      "post": {
        "operationId": "research_v3",
        "summary": "异步研究（async_research 包装，一次性完整结果；流式请用 research_stream）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "调研主题（必填）"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "来源列表"
                  },
                  "domain": {
                    "type": "string",
                    "description": "手动指定领域"
                  },
                  "output_format": {
                    "type": "string"
                  },
                  "lite": {
                    "type": "boolean",
                    "description": "v2.4.0 轻量模式"
                  }
                },
                "required": [
                  "subject"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/research_stream": {
      "post": {
        "operationId": "research_stream",
        "summary": "流式研究（7 步 yield 同步收集；同步 JSON-RPC 下收集全部 yield，SSE 客户端可享受首步优势）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "调研主题（必填）"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "来源列表"
                  },
                  "domain": {
                    "type": "string",
                    "description": "手动指定领域"
                  },
                  "output_format": {
                    "type": "string"
                  },
                  "lite": {
                    "type": "boolean",
                    "description": "v2.4.0 轻量模式"
                  }
                },
                "required": [
                  "subject"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/manage_keys": {
      "post": {
        "operationId": "manage_keys",
        "summary": "Key 生命周期管理（v1.0.1 新增）：list / stat / rotate / revoke。所有输出脱敏（仅指纹）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "action": {
                    "type": "string",
                    "description": "操作类型（list=列出全部脱敏 key；stat=健康/用量；rotate=轮换；revoke=吊销）"
                  },
                  "provider": {
                    "type": "string",
                    "description": "provider 名（deepseek/openai/exa 等，list 可省略）"
                  },
                  "fingerprint": {
                    "type": "string",
                    "description": "revoke 用：key 指纹子串"
                  }
                },
                "required": [
                  "action"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/key_usage": {
      "post": {
        "operationId": "key_usage",
        "summary": "Key 用量/成本报表（v1.0.1 新增）：基于 ~/.infoseek/key_usage.json 输出各 provider 调用数与估算成本。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "_empty": {
                    "type": "string",
                    "description": "占位"
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/qcm_query": {
      "post": {
        "operationId": "qcm_query",
        "summary": "反向调用 QCM：质量危机问题的 4 形态输出（case_application/decision_card/assessment_report/quick_response）。QCM 未安装时优雅降级返回 degraded。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string",
                    "description": "质量问题描述（必填）"
                  },
                  "form": {
                    "type": "string",
                    "description": "输出形态（可选）"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/search_anchors_async": {
      "post": {
        "operationId": "search_anchors_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）多渠道并行锚点发现。从行业/主题/人名嗅探信息源，支持 depth（1-3层）和 sources 列表。返回结构化候选源列表，每项含 url/title/score。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "调研主题（必填）"
                  },
                  "depth": {
                    "type": "number",
                    "description": "关键词展开深度"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "限定渠道（web/kb/note），默认全开"
                  }
                },
                "required": [
                  "subject"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/fetch_content_async": {
      "post": {
        "operationId": "fetch_content_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）内容采集（四级降级提取）。v1.9.0 增强：链式引用追踪 v3（多层递归 + 防环 + 深度折扣 + max_chain_depth 1-3）。v1.8.0 v2：dis",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string",
                    "description": "目标 URL（必填）"
                  },
                  "format": {
                    "type": "string"
                  },
                  "max_retries": {
                    "type": "number"
                  },
                  "follow_links": {
                    "type": "boolean",
                    "description": "是否启用链式引用追踪（v1.7.3）"
                  },
                  "max_depth": {
                    "type": "number",
                    "description": "v1.7.3 追踪深度。v1.8.0 起作用于 v2 全链"
                  },
                  "chain_strategy": {
                    "type": "string",
                    "description": "v1.8.0+: discover/fetch/graph。v1.9.0 新增 recursive=多层递归"
                  },
                  "chain_limit": {
                    "type": "number",
                    "description": "v1.8.0 新增: 链式追踪最大 URL 数"
                  },
                  "max_chain_depth": {
                    "type": "number",
                    "description": "v1.9.0 新增: 递归深度上限（仅 recursive 模式有效）"
                  },
                  "subject": {
                    "type": "string",
                    "description": "v1.8.0 新增: 用于引用相关性评分的主题"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/save_archive_async": {
      "post": {
        "operationId": "save_archive_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）存档归档（v1.4.0 增强）。将抓取内容保存到 infoseek-archives/<subject>/，自动建元数据表与去重检查。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "调研主题（必填）"
                  },
                  "url": {
                    "type": "string",
                    "description": "来源 URL（必填）"
                  },
                  "title": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string",
                    "description": "正文内容"
                  },
                  "metadata": {
                    "type": "object",
                    "description": "附加元数据"
                  }
                },
                "required": [
                  "subject",
                  "url",
                  "title",
                  "content"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/check_dedup_async": {
      "post": {
        "operationId": "check_dedup_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）URL 去重检查。返回是否已在去重 DB 中。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "url": {
                    "type": "string"
                  }
                },
                "required": [
                  "url"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/dedup_stats_async": {
      "post": {
        "operationId": "dedup_stats_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）任务报告：URL 总数、主题分布、抓取时间统计。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string",
                    "description": "可选，限定主题"
                  }
                },
                "required": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/fuse_analysis_async": {
      "post": {
        "operationId": "fuse_analysis_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）融合分析（多源交叉）。输入 subject 与 sources 列表，输出分层根因表。min_score 过滤低质源。v1.8.1 增强：export_formats 参数",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subject": {
                    "type": "string"
                  },
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "源列表 [{url, content, score}, ...]"
                  },
                  "min_score": {
                    "type": "number"
                  },
                  "export_formats": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "v1.8.1 新增：自动导出的格式列表（空=不导出）"
                  }
                },
                "required": [
                  "subject",
                  "sources"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/cross_subject_analysis_async": {
      "post": {
        "operationId": "cross_subject_analysis_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）跨主题关联分析 (v1.6.0 新增)。输入多个调研主题，输出共享源/共同作者/共有概念等关联信息。min_correlation 过滤低相关主题对。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "subjects": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "主题列表（≥2）"
                  },
                  "min_correlation": {
                    "type": "number",
                    "description": "最小共享源数阈值"
                  }
                },
                "required": [
                  "subjects"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/summarize_content_async": {
      "post": {
        "operationId": "summarize_content_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）文本摘要 + 关键词提取 (v1.7.0+)。主路径: summa TextRank（英文友好）+ jieba Textrank（v1.7.1 中文优化）+ LLM API",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "description": "待摘要文本（必填）"
                  },
                  "max_words": {
                    "type": "number",
                    "description": "摘要最大词数"
                  },
                  "prefer": {
                    "type": "string",
                    "description": "首选路径（auto=自动检测语言，jieba=中文专用，llm 仅在配置 API Key 时生效）"
                  }
                },
                "required": [
                  "text"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/conflict_detection_async": {
      "post": {
        "operationId": "conflict_detection_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）跨源事实冲突检测 (v1.8.1+ 第 9 工具)。输入多个来源（含 text/title/url/score），自动识别对同一实体的不同表述/数值，按严重度排序输出冲突列",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "sources": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "来源列表，每项含 text/title/url/score"
                  },
                  "subject": {
                    "type": "string",
                    "description": "调研主题（可选，用于过滤）"
                  },
                  "min_sources": {
                    "type": "number",
                    "description": "最少需要多少个来源才检测（默认 2）"
                  },
                  "max_conflicts": {
                    "type": "number",
                    "description": "最多返回多少个冲突（默认 20）"
                  }
                },
                "required": [
                  "sources"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/score_source_async": {
      "post": {
        "operationId": "score_source_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）v2 评分 (v2.0.1+ 第 10 工具)。单个源 v2 评分：含 trust_bonus（统一信任源加权）+ Jaccard 语义相似度 + domain_bonus",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "object",
                    "description": "源 dict（含 url/platform/title/snippet/score）"
                  },
                  "subject": {
                    "type": "string",
                    "description": "调研主题"
                  },
                  "with_domain": {
                    "type": "boolean",
                    "description": "是否自动应用领域加权"
                  }
                },
                "required": [
                  "source",
                  "subject"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    },
    "/tools/score_contradiction_async": {
      "post": {
        "operationId": "score_contradiction_async",
        "summary": "（v1.0.1 由 sync 定义生成，schema 字段描述完整）v3.0.0 GA 矛盾评分（v2.7.2 引入）。两句话矛盾评分，含 severity 等级。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "claim_a": {
                    "type": "object"
                  },
                  "claim_b": {
                    "type": "object"
                  }
                },
                "required": [
                  "claim_a",
                  "claim_b"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "成功"
          },
          "401": {
            "description": "未授权"
          },
          "400": {
            "description": "参数错误"
          },
          "404": {
            "description": "工具不存在"
          }
        }
      }
    }
  }
}