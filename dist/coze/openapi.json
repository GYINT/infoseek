              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "400": {
            "description": "参数/调用错误"
          },
          "401": {
            "description": "未授权（需 Bearer token）"
          }
        }
      }
    }
  }
}